<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventHandler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav>
            <div class="nav-container">
                <h2 class="logo">EventHandler</h2>
                <ul class="nav-links">
                    <li class="nav-link"><a href="/home">Home</a></li>
                    <li class="nav-link"><a href="/login">Login</a></li>
                    <li class="nav-link"><a href="/register">Register</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <main class="container" style="padding: 4rem 0;">
        <section class="register auth-container">
            <h1 style="text-align: center;">Create Account</h1>
            <form action="/register" method="POST">
                <label for="name">Full Name</label>
                <input type="text" name="name" id="name" required placeholder="John Doe">

                <label for="email">Email Address</label>
                <input type="email" name="email" id="email" required placeholder="john@example.com">

                <label for="password">Password</label>
                <input type="password" name="password" id="password" required placeholder="••••••••">

                <label for="mobile_number">Mobile Number</label>
                <input type="number" name="mobile_number" id="mobile_number" required placeholder="1234567890">

                <label for="gender">Gender</label>
                <select name="gender" id="gender" required>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>

                <button type="submit" class="btn-primary" style="margin-top: 1rem;">Register Now</button>
            </form>
            <div class="auth-link">
                Already have an account? <a href="/login">Login here</a>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-links">
                <a href="/home">Home</a>
                <a href="/events">Events</a>
                <a href="/bookings">My Bookings</a>
            </div>
            <p>&copy; 2026 EventHandler. Powered by Robert Niyonkuru. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>