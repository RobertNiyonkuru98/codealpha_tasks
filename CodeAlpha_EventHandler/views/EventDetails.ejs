<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Events - EventHandler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
    <nav>
        <div class="nav-container">
            <h2 class="logo">EventHandler</h2>
            <ul class="nav-links">
                <li class="nav-link"><a href="/home">Home</a></li>
                <li class="nav-link"><a href="/bookings">My Bookings</a></li>
                <li class="nav-link">
                    <form action="/logout" method="POST" style="display:inline; padding: 0; border: none; background: none;">
                        <button type="submit" class="btn-outline" style="padding: 0.5rem 1rem;">Logout</button>
                    </form>
                </li>
            </ul>
        </div>
    </nav>
    </header>
    <main class="container">
        <section id="events-section" class="events">
            <h1 style="margin-top: 2rem;">Upcoming Events</h1>
            <div class="event-grid">
                <% events.forEach(evt => { %>
                    <div class="event-card">
                        <div class="event-image">
                            <img src="<%= evt.imageUrl || 'https://via.placeholder.com/400x200' %>" alt="<%= evt.title %>">
                        </div>
                        <div class="event-content">
                            <h3><%= evt.title %></h3>
                            <p><strong>Date:</strong> <%= evt.date %></p>
                            <p><strong>Location:</strong> <%= evt.location %></p>
                            <p><strong>Slots Left:</strong> <%= evt.slots %></p>

                            <div class="actions" style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                <button class="btn-outline" onclick="showDetails('<%= evt._id %>')">View Details</button>
                                <a href="/event/<%= evt._id %>/register" class="btn btn-primary">Register</a>
                                <% if (user && user.role === 'admin') { %>
                                    <a href="/event/<%= evt._id %>/attendees" class="btn btn-outline" style="background-color: #6c757d; color: white;">Attendees</a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- Premium Detail Card (Hidden by default) -->
        <section id="event-info" class="fade-in" style="display: none; padding-bottom: 4rem;">
            <button class="btn-outline" onclick="hideDetails()" style="margin-bottom: 2rem;">← Back to All Events</button>

            <div class="detail-card">
                <div class="detail-header">
                    <div>
                        <h1 id="detail-title" style="margin-bottom: 0.5rem;"></h1>
                        <span id="detail-category" class="badge badge-info"></span>
                    </div>
                    <a id="detail-register-btn" href="#" class="btn btn-primary">Register for this Event</a>
                </div>

                <div class="detail-info-grid">
                    <div class="info-item">
                        <label>Description</label>
                        <p id="detail-desc"></p>
                    </div>
                    <div class="info-item">
                        <label>Date & Time</label>
                        <p id="detail-date"></p>
                    </div>
                    <div class="info-item">
                        <label>Location</label>
                        <p id="detail-location"></p>
                    </div>
                    <div class="info-item">
                        <label>Organizer</label>
                        <p id="detail-organizer"></p>
                    </div>
                    <div class="info-item">
                        <label>Available Slots</label>
                        <p id="detail-slots"></p>
                    </div>
                    <div class="info-item">
                        <label>Attendance Type</label>
                        <p id="detail-isOnline"></p>
                    </div>
                </div>

                <div class="detail-image" style="width: 100%; border-radius: 12px; overflow: hidden; height: 300px;">
                    <img id="detail-imageUrl" src="" alt="Event Banner" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-links">
                <a href="/home">Home</a>
                <a href="/events">Events</a>
                <a href="/bookings">My Bookings</a>
            </div>
            <p>&copy; 2026 EventHandler. Powered by Robert Niyonkuru. All rights reserved.</p>
        </div>
    </footer>

    <script>
        const allEvents = <%- JSON.stringify(events) %>;

        function showDetails(eventId) {
            const selectedEvent = allEvents.find(e => e._id === eventId)
            if (selectedEvent) {
                // Populate Data
                document.getElementById('detail-title').innerText = selectedEvent.title
                document.getElementById('detail-desc').innerText = selectedEvent.description
                document.getElementById('detail-date').innerText = selectedEvent.date
                document.getElementById('detail-location').innerText = selectedEvent.location
                document.getElementById('detail-isOnline').innerText = selectedEvent.isOnline ? "Online Event" : "On-site Event"
                document.getElementById('detail-category').innerText = selectedEvent.category
                document.getElementById('detail-organizer').innerText = selectedEvent.organizer
                document.getElementById('detail-slots').innerText = selectedEvent.slots + " slots left"
                document.getElementById('detail-imageUrl').src = selectedEvent.imageUrl || 'https://via.placeholder.com/800x400'
                document.getElementById('detail-register-btn').href = `/event/${selectedEvent._id}/register`

                // Smooth Transition
                document.getElementById('events-section').style.display = 'none';
                document.getElementById('event-info').style.display = 'block';
                window.scrollTo(0, 0);
            }
        }

        function hideDetails() {
            document.getElementById('event-info').style.display = 'none';
            document.getElementById('events-section').style.display = 'block';
        }
    </script>
</body>
</html>