<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - EventHandler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
    <nav>
        <div class="nav-container">
            <h2 class="logo">EventHandler</h2>
            <ul class="nav-links">
                <li class="nav-link"><a href="/home">Home</a></li>
                <li class="nav-link"><a href="/login">Login</a></li>
                <li class="nav-link"><a href="/register">Register</a></li>
            </ul>
        </div>
    </nav>
    </header>
    <main class="container" style="padding: 4rem 0;">
        <section class="login auth-container">
            <h1>Welcome Back</h1>
            <form action="/login" method="POST">
                <label for="email">Email Address</label>
                <input type="email" name="email" id="email" required placeholder="Enter your email">

                <label for="password">Password</label>
                <input type="password" name="password" id="password" required placeholder="••••••••">

                <button type="submit" class="btn-primary" style="margin-top: 1rem;">Sign In</button>
            </form>
            <div class="auth-link">
                Don't have an account? <a href="/register">Register here</a>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-links">
                <a href="/home">Home</a>
                <a href="/events">Events</a>
                <a href="/bookings">My Bookings</a>
            </div>
            <p>&copy; 2026 EventHandler. Powered by Robert Niyonkuru. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>