<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - EventHandler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
    <nav>
        <div class="nav-container">
            <h2 class="logo">EventHandler</h2>
            <ul class="nav-links">
                <li class="nav-link"><a href="/home">Home</a></li>
                <li class="nav-link"><a href="/bookings">My Bookings</a></li>
                <li class="nav-link">
                    <form action="/logout" method="POST" style="display:inline; padding: 0; border: none; background: none;">
                        <button type="submit" class="btn-outline" style="padding: 0.5rem 1rem;">Logout</button>
                    </form>
                </li>
            </ul>
        </div>
    </nav>
    </header>
    <main class="container">
        <section>
    <nav>
        <a href="/events">← Back to Events</a>
    </nav>
            <div class="container">
                <h1>Register for: <%= event.title %></h1>
                <p>Date: <%= event.date %></p>
                <p>Location: <%= event.location %></p>

                <form action="/event/<%= event._id %>/register" method="POST">
                    <input type="hidden" name="eventId" value="<%= event._id %>">

                    <label for="name">Your Name</label>
                    <input type="text" name="name" id="name" value="<%= user.name %>" readonly>

                    <label for="email">Email</label>
                    <input type="email" name="email" id="email" value="<%= user.email %>" readonly>

                    <label for="phone">Phone</label>
                    <input type="text" name="phone" id="phone" value="<%= user.mobile_number %>" required>

                    <label for="gender">Gender</label>
                    <select name="gender" id="gender" required>
                        <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                        <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                        <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                    </select>

                    <button type="submit">Confirm Registration</button>
                </form>
            </div>
        </section>
    </main>
    <footer>
        <div class="footer-container">
            <p>&copy; 2026 EventHandler. Powered by Robert Niyonkuru. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>