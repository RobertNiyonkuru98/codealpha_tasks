<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
</head>
<body>
    <header>
    <nav>
        <div class="nav-container">
        <ul class="nav-links">
            <li class="nav-link"><a href="/home">Home</a></li>
            <li class="nav-link"><a href="/profile">Profile</a></li>
            <li class="nav-link"><a href="/bookings">Bookings</a></li>
            <li class="nav-link">
                <form action="/logout" method="POST" style="display:inline;">
                    <button type="submit">Logout</button>
                </form>
            </li>
        </ul>
        </div>
    </nav>
    </header>
    <main>
        <section class="dashboard">
            <div>
                <div class="dashboard-header">
                    <h1>CodeAlpha Event Management System</h1>
                </div>
                <div class="dashboard-content">
                    <h1>Your dashboard</h1>
                    <% if (user) { %>
                        <h2>Hello <%= user.name %>!</h2>
                        <h3>Welcome back to our event booking platform.</h3>
                        <button><a href="/events">View Upcoming Events</a></button>
                        <% if (user.role === 'admin') { %>
                            <button><a href="/event/create">Create New Event</a></button>
                        <% } %>
<% } else { %>
                        <h2>Hello there!</h2>
                        <h3>Join us to explore and book amazing events.</h3>
                        <div class="guest-buttons">
                            <button><a href="/login">Login</a></button>
                            <button><a href="/register">Register</a></button>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>
    </main>
</body>
</html>