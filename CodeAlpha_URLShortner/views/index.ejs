<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>URL SHORTNER</title>
</head>

<body>
    <div class="container">
        <h1>CodeAlpha URL Shortner</h1>
        <p>Be able to shorten URLs, For your own use.</p>
        <form action="" method="POST" class="my-4 form-inline">
            <label for="fullUrl" class="sr-only ">Full URL</label>
            <input required type="url" placeholder="Enter your URL" name="FullUrl" id="fullUrl" class="form-control col mr-2">
            <button type="submit" class="btn btn-success">Shorten</button>
        </form>
    </div>

    <table class="table table-striped table-responsive">
        <thead>
            <tr>
                <th>Full Url</th>
                <th>Short Url</th>
                <th>Hits</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><a href="https://github.com/RobertNiyonkuru98">https://github.com/RobertNiyonkuru98</a></td>
                <td><a href="/MyGithub">MyGithub</a></td>
                <td>10</td>
            </tr>
        </tbody>
    </table>
</body>

</html>