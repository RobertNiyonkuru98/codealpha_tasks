<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Initialize Profile - Hexcraft Dining</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header>
        <div class="header-container">
            <a href="/" class="logo">HEXCRAFT <span>RESTO</span></a>
            <nav>
                <ul>
                    <li><a href="/register" class="active">Register</a></li>
                    <li><a href="/login">Login</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main style="display:flex; align-items:center; justify-content:center;">
        <div class="form-container" style="width:100%; margin:1rem 0;">
            <h1 class="page-title" style="font-size:2rem; margin-bottom:1.5rem; text-align:center; display:block;">
                Create Account</h1>

            <form action="/register" method="POST">
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" name="name" class="form-control" placeholder="Wanda Maximoff" required>
                </div>
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" name="email" class="form-control" placeholder="wanda@maximoff.anomaly" required>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••••••••" required>
                </div>
                <div class="form-group">
                    <label>Mobile Number</label>
                    <input type="text" name="mobile_number" class="form-control" placeholder="+1 (555) 019-2834">
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                    <div class="form-group">
                        <label>Gender</label>
                        <select name="gender" class="form-control">
                            <option value="female">Female</option>
                            <option value="male">Male</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Assigned Role</label>
                        <select name="role" class="form-control">
                            <option value="customer">Customer</option>
                            <option value="staff">Staff</option>
                            <option value="manager">Manager</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn" style="width:100%; margin-top:1rem;">Manifest Profile</button>
            </form>

            <div
                style="text-align:center; margin-top:1.5rem; border-top:1px solid var(--border-color); padding-top:1rem;">
                <p style="color:var(--text-muted); font-size:0.95rem;">
                    Already integrated? <a href="/login"
                        style="color:var(--primary-glow); text-decoration:none; font-weight:600;">Authenticate Here</a>
                </p>
            </div>
        </div>
    </main>

    <footer>
        <div class="footer-content">
            <p class="footer-brand">HEXCRAFT RESTO &copy; 2026</p>
            <p style="font-size:0.8rem;">Powered by Chaos Magic & Professional Hospitality</p>
        </div>
    </footer>
</body>

</html>