<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Restaurant Management - Lobby</title>
</head>
<body>
    <header>
        <h1>Restaurant Dashboard</h1>
        <% if (user) { %>
            <p>Welcome, <strong><%= user.name %></strong>!</p>
        <% } %>
        <nav>
            <a href="/logout">Logout</a>
        </nav>
    </header>

    <main>
        <h2>Quick Actions</h2>
        <ul>
            <!-- All logged-in users can view the menu and tables -->
            <li><a href="/menu">View Menu</a></li>
            <li><a href="/tables">View Tables</a></li>

            <% if (user && user.role === 'customer') { %>
                <li><a href="/reservations">Book a Table</a></li>
                <li><a href="/orders/new">Place an Order</a></li>
            <% } %>

            <% if (user && (user.role === 'admin' || user.role === 'manager')) { %>
                <li><a href="/orders">Manage Orders</a></li>
                <li><a href="/inventory">Inventory Management</a></li>
                <li><a href="/inventory/lowstock">Low Stock Alerts</a></li>
                <li><a href="/reports/daily-sales">Daily Sales Report</a></li>
                <li><a href="/reports/weekly-sales">Weekly Sales Report</a></li>
            <% } %>
        </ul>
    </main>
</body>
</html>