<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Low Stock Alerts</title>
</head>
<body>
    <h1>Low Stock Alerts</h1>
    <a href="/inventory">Back to Inventory</a> | <a href="/home">Back to Lobby</a>

    <section>
        <% if (lowStockItems && lowStockItems.length > 0) { %>
            <p><strong>Warning:</strong> The following items are running low and need to be restocked.</p>
            <table border="1" cellpadding="8">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Current Quantity</th>
                        <th>Minimum Level</th>
                        <th>Unit</th>
                        <th>Shortage</th>
                    </tr>
                </thead>
                <tbody>
                    <% lowStockItems.forEach(item => { %>
                        <tr>
                            <td><%= item.itemName %></td>
                            <td><%= item.quantity %></td>
                            <td><%= item.minimumLevel %></td>
                            <td><%= item.unit || '-' %></td>
                            <td><%= item.minimumLevel - item.quantity %> units short</td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p>All inventory items are sufficiently stocked. No alerts at this time.</p>
        <% } %>
    </section>
</body>
</html>
